pipeline {
    agent any
    environment {
        DOCKER_REGISTRY_URL = 'http://172.20.0.36:5000'
        DOCKER_CREDENTIALS_ID = 'your-docker-credentials-id'
        SSH_CREDENTIALS_ID = 'your-ssh-credentials-id'
    }
    stages {
        stage('Input Image and Tag') {
            steps {
                script {
                    // Get the image name, tag, and server IP from the user
                    def userInput = input(
                        id: 'userInput', message: 'Please provide the Docker image name, tag, and server IP:',
                        parameters: [
                            string(name: 'ImageName', defaultValue: '"jenkins2.0-6.12"', description: 'Docker image name'),
                            string(name: 'ImageTag', defaultValue: 'latest', description: 'Docker image tag'),
                            string(name: 'ServerIP', defaultValue: '192.168.1.100', description: 'Server IP address')
                        ]
                    )

                    // Remove quotes from the ImageName
                    env.IMAGE_NAME = userInput['ImageName'].replaceAll('"', '')
                    env.IMAGE_TAG = userInput['ImageTag']
                    env.SERVER_IP = userInput['ServerIP']

                    echo "Selected Repository: ${env.IMAGE_NAME}"
                    echo "Selected Tag: ${env.IMAGE_TAG}"
                    echo "Selected Server IP: ${env.SERVER_IP}"
                }
            }
        }
        stage('Check if Tag Exists') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        // Use curl to get the list of tags for the image
                        def tagCheckCmd = "curl -s -u ${DOCKER_USERNAME}:${DOCKER_PASSWORD} ${DOCKER_REGISTRY_URL}/v2/${env.IMAGE_NAME}/tags/list"
                        def response = sh(script: tagCheckCmd, returnStdout: true).trim()
                        def jsonResponse = readJSON text: response

                        if (jsonResponse.errors) {
                            error "Image '${env.IMAGE_NAME}' does not exist in the Docker registry."
                        } else {
                            def tags = jsonResponse.tags
                            if (tags.contains(env.IMAGE_TAG)) {
                                echo "Tag '${env.IMAGE_TAG}' exists for image '${env.IMAGE_NAME}' in the Docker registry."
                            } else {
                                error "Tag '${env.IMAGE_TAG}' does not exist for image '${env.IMAGE_NAME}' in the Docker registry."
                            }
                        }
                    }
                }
            }
        }
        stage('Deploy Image to Server') {
            steps {
                script {
                    // Deploy the Docker container to the specified server
                    sshagent([SSH_CREDENTIALS_ID]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ${env.SERVER_IP} \\
                            "docker pull ${DOCKER_REGISTRY_URL}/${env.IMAGE_NAME}:${env.IMAGE_TAG} && \\
                             docker stop ${env.IMAGE_NAME} || true && \\
                             docker rm ${env.IMAGE_NAME} || true && \\
                             docker run -d --name ${env.IMAGE_NAME} ${DOCKER_REGISTRY_URL}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                        """
                    }
                }
            }
        }
    }
}
